{
  "$schema": "../../../schemas/component.schema.json",
  "schemaVersion": "1.0.0",
  "identity": {
    "id": "module.relay.electromechanical.two-channel",
    "name": "2-Channel Electromechanical Relay Module",
    "category": "module",
    "subCategory": "relay"
  },
  "simulation": {
    "kind": "active-electrical",
    "effects": [
      "electrical",
      "visual-state"
    ],
    "implemented": true,
    "notes": [
      "Educational electrical rules enabled: wiring, activation, floating inputs and current/voltage limit diagnostics."
    ]
  },
