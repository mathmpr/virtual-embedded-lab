      "minimum": 2,
      "maximum": 2,
      "simulationUpdate": "none"
    },
    "activeHigh": {
      "type": "boolean",
      "default": true,
      "simulationUpdate": "rerun"
    },
    "ratedCurrentAmps": {
      "type": "number",
      "default": 10,
      "minimum": 0,
      "maximum": 40,
      "unit": "A",
