      "spi": [{ "id": "spi", "sck": "io12", "miso": "io13", "mosi": "io11", "defaultCs": "io10" }]
    },
    "builtInLeds": [
      { "id": "rgb", "label": "RGB", "pin": 48, "terminalId": "io48", "activeHigh": true, "color": "blue" }
