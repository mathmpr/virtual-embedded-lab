{
  "$schema": "../../../schemas/component.schema.json",
  "schemaVersion": "1.0.0",
  "identity": {
    "id": "sensor.motion.pir.hc-sr501",
    "name": "PIR HC-SR501 Motion Sensor",
    "category": "sensor",
    "subCategory": "motion"
  },
  "simulation": {
    "kind": "behavioral-sensor",
    "effects": ["firmware", "electrical", "visual-state"],
    "implemented": true,
    "notes": ["Motion is controlled directly on the component for deterministic lessons."]
  },
  "properties": {
    "pressed": { "type": "boolean", "default": false, "simulationUpdate": "live" },
    "activeHigh": { "type": "boolean", "default": true, "simulationUpdate": "rerun" }
  },
  "terminals": [
    { "id": "vcc", "label": "VCC", "type": "power-input" },
    { "id": "out", "label": "OUT", "type": "digital-output" },
    { "id": "gnd", "label": "GND", "type": "ground" }
  ],
  "behavior": {
    "type": "momentary-button",
    "outputTerminal": "out",
    "activeProperty": "pressed",
    "activeHighProperty": "activeHigh"
  },
  "electricalModel": {
    "type": "sensor-module",
    "logicVoltage": 5,
    "recommendedVoltageVolts": 5,
    "inputCurrentAmps": 0.001,
    "maximumCurrentAmps": 0.02
  },
  "visual": {
    "type": "pir-hc-sr501",
    "title": "PIR HC-SR501",
    "className": "maker-pir",
    "body": "NO MOTION",
    "width": 184,
    "height": 112,
    "controls": [
      { "type": "readout", "className": "button-readout", "label": "Motion", "property": "pressed", "format": "onOff" },
      { "type": "checkbox", "label": "Movimento", "property": "pressed" }
    ],
    "stateBindings": [
      { "type": "class", "className": "motion-detected", "source": { "kind": "componentProperty", "property": "pressed" }, "when": true }
    ],
    "palette": { "group": "Sensors", "subgroup": "Motion", "icon": "pir-icon", "order": 42 },
    "terminals": [
      { "id": "vcc", "label": "VCC", "side": "left", "x": 0, "y": 30, "kind": "power" },
      { "id": "out", "label": "OUT", "side": "right", "x": 184, "y": 56, "kind": "signal" },
      { "id": "gnd", "label": "GND", "side": "bottom", "x": 92, "y": 112, "kind": "ground" }
    ]
  }
}
