{
  "$schema": "../../../schemas/component.schema.json",
  "schemaVersion": "1.0.0",
  "identity": {
    "id": "sensor.magnetic.reed-switch",
    "name": "Reed Switch",
    "category": "sensor",
    "subCategory": "magnetic"
  },
  "simulation": {
    "kind": "behavioral-sensor",
    "effects": ["firmware", "electrical", "visual-state"],
    "implemented": true
  },
  "properties": {
    "pressed": { "type": "boolean", "default": false, "simulationUpdate": "live" },
    "activeHigh": { "type": "boolean", "default": true, "simulationUpdate": "rerun" }
  },
  "terminals": [
    { "id": "vcc", "label": "VCC", "type": "power-input" },
    { "id": "out", "label": "OUT", "type": "digital-output" },
    { "id": "gnd", "label": "GND", "type": "ground" }
  ],
  "behavior": {
    "type": "momentary-button",
    "outputTerminal": "out",
    "activeProperty": "pressed",
    "activeHighProperty": "activeHigh"
  },
  "electricalModel": {
    "type": "sensor-module",
    "logicVoltage": 5,
    "recommendedVoltageVolts": 5,
    "inputCurrentAmps": 0.001,
    "maximumCurrentAmps": 0.02
  },
  "visual": {
    "type": "reed-switch",
    "title": "Reed Switch",
    "className": "maker-reed",
    "body": "OPEN",
    "width": 172,
    "height": 104,
    "controls": [
      { "type": "readout", "className": "button-readout", "label": "Reed", "property": "pressed", "format": "onOff" },
      { "type": "checkbox", "label": "Fechado", "property": "pressed" }
    ],
    "palette": { "group": "Sensors", "subgroup": "Magnetic", "icon": "reed-icon", "order": 78 },
    "terminals": [
      { "id": "vcc", "label": "VCC", "side": "left", "x": 0, "y": 28, "kind": "power" },
      { "id": "out", "label": "OUT", "side": "right", "x": 172, "y": 52, "kind": "signal" },
      { "id": "gnd", "label": "GND", "side": "bottom", "x": 86, "y": 104, "kind": "ground" }
    ]
  }
}
