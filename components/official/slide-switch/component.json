{
  "$schema": "../../../schemas/component.schema.json",
  "schemaVersion": "1.0.0",
  "identity": {
    "id": "input.switch.slide",
    "name": "Slide Switch",
    "category": "input",
    "subCategory": "switches"
  },
  "simulation": {
    "kind": "behavioral-sensor",
    "effects": ["firmware", "electrical", "visual-state"],
    "implemented": true
  },
  "properties": {
    "pressed": { "type": "boolean", "default": false, "simulationUpdate": "live" },
    "activeHigh": { "type": "boolean", "default": true, "simulationUpdate": "rerun" }
  },
  "terminals": [
    { "id": "vcc", "label": "VCC", "type": "power-input" },
    { "id": "out", "label": "OUT", "type": "digital-output" },
    { "id": "gnd", "label": "GND", "type": "ground" }
  ],
  "behavior": {
    "type": "momentary-button",
    "outputTerminal": "out",
    "activeProperty": "pressed",
    "activeHighProperty": "activeHigh"
  },
  "electricalModel": {
    "type": "sensor-module",
    "logicVoltage": 5,
    "recommendedVoltageVolts": 5,
    "inputCurrentAmps": 0.001,
    "maximumCurrentAmps": 0.02
  },
  "visual": {
    "type": "slide-switch",
    "title": "Slide Switch",
    "className": "maker-slide-switch",
    "body": "OFF",
    "width": 174,
    "height": 104,
    "controls": [
      { "type": "readout", "className": "button-readout", "label": "SW", "property": "pressed", "format": "onOff" },
      { "type": "checkbox", "className": "component-checkbox-row", "label": "Ligada", "property": "pressed" }
    ],
    "stateBindings": [
      { "type": "class", "className": "is-on", "source": { "kind": "componentProperty", "property": "pressed" }, "when": true }
    ],
    "palette": { "group": "Inputs", "subgroup": "Switches", "icon": "switch-icon", "order": 41 },
    "terminals": [
      { "id": "vcc", "label": "VCC", "side": "left", "x": 0, "y": 28, "kind": "power" },
      { "id": "out", "label": "OUT", "side": "right", "x": 174, "y": 52, "kind": "signal" },
      { "id": "gnd", "label": "GND", "side": "bottom", "x": 87, "y": 104, "kind": "ground" }
    ]
  }
}
