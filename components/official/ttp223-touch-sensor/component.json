{
  "$schema": "../../../schemas/component.schema.json",
  "schemaVersion": "1.0.0",
  "identity": {
    "id": "input.touch.ttp223",
    "name": "TTP223 Capacitive Touch",
    "category": "input",
    "subCategory": "touch"
  },
  "simulation": {
    "kind": "behavioral-sensor",
    "effects": ["firmware", "electrical", "visual-state"],
    "implemented": true
  },
  "properties": {
    "pressed": { "type": "boolean", "default": false, "simulationUpdate": "live" },
    "activeHigh": { "type": "boolean", "default": true, "simulationUpdate": "rerun" }
  },
  "terminals": [
    { "id": "vcc", "label": "VCC", "type": "power-input" },
    { "id": "out", "label": "OUT", "type": "digital-output" },
    { "id": "gnd", "label": "GND", "type": "ground" }
  ],
  "behavior": {
    "type": "momentary-button",
    "outputTerminal": "out",
    "activeProperty": "pressed",
    "activeHighProperty": "activeHigh"
  },
  "electricalModel": {
    "type": "sensor-module",
    "logicVoltage": 5,
    "recommendedVoltageVolts": 5,
    "inputCurrentAmps": 0.003,
    "maximumCurrentAmps": 0.02
  },
  "visual": {
    "type": "ttp223-touch-sensor",
    "title": "TTP223",
    "className": "maker-touch-sensor",
    "body": "TOUCH",
    "width": 170,
    "height": 104,
    "controls": [
      { "type": "readout", "className": "button-readout", "label": "TOUCH", "property": "pressed", "format": "onOff" },
      { "type": "pulse", "label": "Touch", "property": "pressed", "durationMs": 180 }
    ],
    "stateBindings": [
      { "type": "class", "className": "is-touched", "source": { "kind": "componentProperty", "property": "pressed" }, "when": true }
    ],
    "palette": { "group": "Inputs", "subgroup": "Touch", "icon": "touch-icon", "order": 44 },
    "terminals": [
      { "id": "vcc", "label": "VCC", "side": "left", "x": 0, "y": 28, "kind": "power" },
      { "id": "out", "label": "OUT", "side": "right", "x": 170, "y": 52, "kind": "signal" },
      { "id": "gnd", "label": "GND", "side": "bottom", "x": 85, "y": 104, "kind": "ground" }
    ]
  }
}
