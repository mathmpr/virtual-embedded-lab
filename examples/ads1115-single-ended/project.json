{
  "schemaVersion": "1.0.0",
  "name": "ADS1115 Single Ended",
  "description": "Demonstra a leitura single-ended de uma fonte analógica externa usando o ADC ADS1115 conectado ao Arduino UNO por I2C.",
  "descriptionI18n": {
    "pt-BR": "Demonstra a leitura single-ended de uma fonte analógica externa usando o ADC ADS1115 conectado ao Arduino UNO por I2C.",
    "en": "Demonstrates single-ended reading from an external analog source using the ADS1115 ADC connected to an Arduino UNO over I2C.",
    "es": "Demuestra la lectura single-ended de una fuente analógica externa usando el ADC ADS1115 conectado a un Arduino UNO por I2C."
  },
  "board": {
    "width": 1600,
    "height": 900,
    "gridSize": 10
  },
  "components": [
    {
      "id": "arduino-1",
      "componentId": "board.arduino.uno",
      "position": {
        "x": 240,
        "y": 220
      },
      "properties": {}
    },
    {
      "id": "ads1115-1",
      "componentId": "converter.adc.ads1115",
      "position": {
        "x": 710,
        "y": 250
      },
      "properties": {
        "i2cAddress": 72,
        "gain": "2.048V",
        "sampleRateSps": 128,
        "mode": "single-shot"
      }
    },
    {
      "id": "analog-1",
      "componentId": "environment.analog-voltage-source",
      "position": {
        "x": 1000,
        "y": 270
      },
      "properties": {
        "enabled": true,
        "voltageVolts": 1.024
      }
    }
  ],
  "connections": [
    {
      "id": "net-1",
      "color": "#f05252",
      "terminals": [
        "arduino-1.3v3",
        "ads1115-1.vdd"
      ]
    },
    {
      "id": "net-2",
      "color": "#f5f7fa",
      "terminals": [
        "arduino-1.gnd",
        "ads1115-1.gnd",
        "analog-1.gnd"
      ]
    },
    {
      "id": "net-3",
      "color": "#45d6c4",
      "terminals": [
        "arduino-1.a4",
        "ads1115-1.sda"
      ]
    },
    {
      "id": "net-4",
      "color": "#4c8dff",
      "terminals": [
        "arduino-1.a5",
        "ads1115-1.scl"
      ]
    },
    {
      "id": "net-5",
      "color": "#ffb454",
      "terminals": [
        "analog-1.out",
        "ads1115-1.a0"
      ]
    }
  ],
  "environmentConnections": [],
  "code": {
    "language": "arduino-cpp",
    "entry": "main.ino",
    "files": {
      "main.ino": {
        "path": "./firmware/main.ino"
      }
    }
  }
}
