{
  "schemaVersion": "1.0.0",
  "name": "Arduino DHT22 Climate",
  "board": {
    "width": 1500,
    "height": 860,
    "gridSize": 10
  },
  "components": [
    {
      "id": "arduino-1",
      "componentId": "board.arduino.uno",
      "position": {
        "x": 260,
        "y": 240
      },
      "properties": {}
    },
    {
      "id": "dht-1",
      "componentId": "sensor.temperature-humidity.dht22",
      "position": {
        "x": 760,
        "y": 260
      },
      "properties": {
        "temperatureCelsius": 25,
        "humidityPercent": 55,
        "sensorModel": "DHT22",
        "readIntervalMs": 2000
      }
    },
    {
      "id": "climate-1",
      "componentId": "environment.climate",
      "position": {
        "x": 1040,
        "y": 250
      },
      "properties": {
        "enabled": true,
        "temperatureC": 28,
        "pressureHpa": 1013.25,
        "humidityPercent": 68
      }
    }
  ],
  "connections": [
    {
      "id": "net-vcc",
      "color": "#f05252",
      "terminals": [
        "arduino-1.5v",
        "dht-1.vcc"
      ]
    },
    {
      "id": "net-gnd",
      "color": "#f5f7fa",
      "terminals": [
        "arduino-1.gnd",
        "dht-1.gnd"
      ]
    },
    {
      "id": "net-data",
      "color": "#ffb454",
      "terminals": [
        "arduino-1.d2",
        "dht-1.data"
      ]
    }
  ],
  "environmentConnections": [
    {
      "source": "climate-1.climate",
      "target": "dht-1.env",
      "color": "#6fbf73"
    }
  ],
  "code": {
    "language": "arduino-cpp",
    "entry": "main.ino",
    "files": {
      "main.ino": {
        "path": "./firmware/main.ino"
      }
    }
  }
}
