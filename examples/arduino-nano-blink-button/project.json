{
  "schemaVersion": "1.0.0",
  "name": "Arduino Nano Blink Button",
  "description": "Usa um Arduino Nano com botão pull-up para alternar um LED azul externo e o LED interno da placa.",
  "descriptionI18n": {
    "pt-BR": "Usa um Arduino Nano com botão pull-up para alternar um LED azul externo e o LED interno da placa.",
    "en": "Uses an Arduino Nano with a pull-up button to toggle an external blue LED and the board LED.",
    "es": "Usa un Arduino Nano con botón pull-up para alternar un LED azul externo y el LED integrado de la placa."
  },
  "board": {
    "width": 1500,
    "height": 860,
    "gridSize": 10
  },
  "components": [
    {
      "id": "nano-1",
      "componentId": "board.arduino.nano",
      "position": {
        "x": 300,
        "y": 210
      },
      "properties": {
        "logicVoltage": 5,
        "clockMHz": 16,
        "usbPowered": true
      }
    },
    {
      "id": "button-1",
      "componentId": "input.button.pull-up",
      "position": {
        "x": 720,
        "y": 280
      },
      "properties": {
        "pressed": false,
        "activeHigh": true
      }
    },
    {
      "id": "resistor-1",
      "componentId": "electronic.resistor",
      "position": {
        "x": 900,
        "y": 420
      },
      "properties": {
        "resistanceOhms": 220
      }
    },
    {
      "id": "led-1",
      "componentId": "electronic.led.blue",
      "position": {
        "x": 1080,
        "y": 390
      },
      "properties": {}
    }
  ],
  "connections": [
    {
      "id": "net-vcc",
      "color": "#f05252",
      "terminals": [
        "nano-1.5v",
        "button-1.vcc"
      ]
    },
    {
      "id": "net-gnd",
      "color": "#f5f7fa",
      "terminals": [
        "nano-1.gnd",
        "button-1.gnd",
        "led-1.cathode"
      ]
    },
    {
      "id": "net-button",
      "color": "#ffb454",
      "terminals": [
        "nano-1.d2",
        "button-1.out"
      ]
    },
    {
      "id": "net-led-drive",
      "color": "#4c8dff",
      "terminals": [
        "nano-1.d9",
        "resistor-1.a"
      ]
    },
    {
      "id": "net-led-anode",
      "color": "#45d6c4",
      "terminals": [
        "resistor-1.b",
        "led-1.anode"
      ]
    }
  ],
  "environmentConnections": [],
  "code": {
    "language": "arduino-cpp",
    "entry": "main.ino",
    "files": {
      "main.ino": {
        "path": "./firmware/main.ino"
      }
    }
  }
}
