{
  "schemaVersion": "1.0.0",
  "name": "Pull-up Button Toggle Blue LED",
  "description": "Demonstra entrada digital com botão pull-up no Arduino UNO alternando o estado de um LED azul.",
  "descriptionI18n": {
    "pt-BR": "Demonstra entrada digital com botão pull-up no Arduino UNO alternando o estado de um LED azul.",
    "en": "Demonstrates a digital pull-up button input on an Arduino UNO toggling a blue LED.",
    "es": "Demuestra una entrada digital con botón pull-up en un Arduino UNO alternando un LED azul."
  },
  "board": {
    "width": 1600,
    "height": 900,
    "gridSize": 10
  },
  "components": [
    {
      "id": "arduino-1",
      "componentId": "board.arduino.uno",
      "position": {
        "x": 300,
        "y": 220
      },
      "properties": {}
    },
    {
      "id": "button-1",
      "componentId": "input.button.pull-up",
      "position": {
        "x": 760,
        "y": 210
      },
      "properties": {
        "pressed": false,
        "activeHigh": true
      }
    },
    {
      "id": "resistor-1",
      "componentId": "electronic.resistor",
      "position": {
        "x": 840,
        "y": 435
      },
      "properties": {
        "resistanceOhms": 220
      }
    },
    {
      "id": "led-1",
      "componentId": "electronic.led.blue",
      "position": {
        "x": 1050,
        "y": 470
      },
      "properties": {}
    }
  ],
  "connections": [
    {
      "id": "net-1",
      "color": "#f05252",
      "terminals": [
        "arduino-1.5v",
        "button-1.vcc"
      ]
    },
    {
      "id": "net-2",
      "color": "#f5f7fa",
      "terminals": [
        "arduino-1.gnd",
        "button-1.gnd",
        "led-1.cathode"
      ]
    },
    {
      "id": "net-3",
      "color": "#45d6c4",
      "terminals": [
        "arduino-1.d2",
        "button-1.out"
      ]
    },
    {
      "id": "net-4",
      "color": "#4c8dff",
      "terminals": [
        "arduino-1.d13",
        "resistor-1.a"
      ]
    },
    {
      "id": "net-5",
      "color": "#4c8dff",
      "terminals": [
        "resistor-1.b",
        "led-1.anode"
      ]
    }
  ],
  "environmentConnections": [],
  "code": {
    "language": "arduino-cpp",
    "entry": "main.ino",
    "files": {
      "main.ino": {
        "path": "./firmware/main.ino"
      }
    }
  }
}
