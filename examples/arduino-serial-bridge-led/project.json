{
  "schemaVersion": "1.0.0",
  "name": "Arduino Serial Bridge LED",
  "board": {
    "width": 1600,
    "height": 900,
    "gridSize": 10
  },
  "components": [
    {
      "id": "arduino-1",
      "componentId": "board.arduino.uno",
      "position": {
        "x": 260,
        "y": 210
      },
      "properties": {}
    },
    {
      "id": "arduino-2",
      "componentId": "board.arduino.uno",
      "position": {
        "x": 760,
        "y": 210
      },
      "properties": {}
    },
    {
      "id": "resistor-1",
      "componentId": "electronic.resistor",
      "position": {
        "x": 1140,
        "y": 330
      },
      "properties": {
        "resistanceOhms": 220
      }
    },
    {
      "id": "led-1",
      "componentId": "electronic.led.red",
      "position": {
        "x": 1330,
        "y": 380
      },
      "properties": {}
    }
  ],
  "connections": [
