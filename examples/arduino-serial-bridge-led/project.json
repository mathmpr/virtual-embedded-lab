        "led-1.cathode"
      ]
    },
    {
      "id": "net-3",
      "color": "#ffb454",
      "terminals": [
        "arduino-2.d13",
        "resistor-1.a"
      ]
    },
    {
      "id": "net-4",
      "color": "#ffb454",
      "terminals": [
        "resistor-1.b",
        "led-1.anode"
      ]
    }
  ],
  "environmentConnections": [],
  "firmwares": {
    "arduino-1": {
      "language": "arduino-cpp",
