{
  "schemaVersion": "1.0.0",
  "name": "Arduino Servo Sweep",
  "description": "Executa o movimento de varredura de um servo motor controlado por PWM pelo Arduino UNO.",
  "descriptionI18n": {
    "pt-BR": "Executa o movimento de varredura de um servo motor controlado por PWM pelo Arduino UNO.",
    "en": "Runs a sweep movement on a servo motor controlled by Arduino UNO PWM.",
    "es": "Ejecuta un movimiento de barrido en un servomotor controlado por PWM desde un Arduino UNO."
  },
  "board": {
    "width": 1500,
    "height": 860,
    "gridSize": 10
  },
  "components": [
    {
      "id": "arduino-1",
      "componentId": "board.arduino.uno",
      "position": {
        "x": 280,
        "y": 240
      },
      "properties": {}
    },
    {
      "id": "servo-1",
      "componentId": "actuator.servo.motor",
      "position": {
        "x": 800,
        "y": 285
      },
      "properties": {
        "angleDegrees": 90,
        "attached": false,
        "minPulseUs": 544,
        "maxPulseUs": 2400,
        "stallCurrentAmps": 0.65,
        "noLoadCurrentAmps": 0.15
      }
    }
  ],
  "connections": [
    {
      "id": "net-vcc",
      "color": "#f05252",
      "terminals": [
        "arduino-1.5v",
        "servo-1.vcc"
      ]
    },
    {
      "id": "net-gnd",
      "color": "#f5f7fa",
      "terminals": [
        "arduino-1.gnd",
        "servo-1.gnd"
      ]
    },
    {
      "id": "net-sig",
      "color": "#ffb454",
      "terminals": [
        "arduino-1.d9",
        "servo-1.sig"
      ]
    }
  ],
  "environmentConnections": [],
  "code": {
    "language": "arduino-cpp",
    "entry": "main.ino",
    "files": {
      "main.ino": {
        "path": "./firmware/main.ino"
      }
    }
  }
}
