{
  "schemaVersion": "1.0.0",
  "name": "ESP Water Control Pump Reservoir",
  "description": "Demonstra controle de bomba e reservatório com ESP8266 e ESP32 comunicando por rede virtual e sensores de chuva.",
  "descriptionI18n": {
    "pt-BR": "Demonstra controle de bomba e reservatório com ESP8266 e ESP32 comunicando por rede virtual e sensores de chuva.",
    "en": "Demonstrates pump and reservoir control with ESP8266 and ESP32 communicating over a virtual network and rain sensors.",
    "es": "Demuestra control de bomba y reservorio con ESP8266 y ESP32 comunicándose por una red virtual y sensores de lluvia."
  },
  "board": {
    "width": 1800,
    "height": 1000,
    "gridSize": 10
  },
  "components": [
    {
      "id": "esp8266-asker",
      "componentId": "board.esp8266.nodemcu",
      "position": {
        "x": 0,
        "y": 180
      },
      "properties": {
        "logicVoltage": 3.3,
        "wifiMode": "station"
      }
    },
    {
      "id": "esp32-sender",
      "componentId": "board.esp32.devkit",
      "position": {
        "x": 1040,
        "y": 110
      },
      "properties": {
        "logicVoltage": 3.3,
        "wifiMode": "station",
        "bluetoothEnabled": false
      }
    },
    {
      "id": "wifi-1",
      "componentId": "environment.wifi-signal",
      "position": {
        "x": 650,
        "y": 50
      },
      "properties": {
        "ssid": "VirtualLab",
        "connected": true,
        "strengthPercent": 88
      }
    },
    {
      "id": "ssr-1",
      "componentId": "module.relay.ssr.one-channel",
      "position": {
        "x": 530,
        "y": 265
      },
      "properties": {
        "activeHigh": false,
        "ratedCurrentAmps": 2,
        "ratedVoltageVolts": 24
      }
    },
    {
      "id": "pump-1",
      "componentId": "actuator.water-pump",
      "position": {
        "x": 770,
        "y": 300
      },
      "properties": {
        "enabled": false,
        "flowLitersPerHour": 1200,
        "nominalVoltageVolts": 5,
        "currentAmps": 0.5
      }
    },
    {
      "id": "reservoir-1",
      "componentId": "environment.water-reservoir",
      "position": {
        "x": 760,
        "y": 597
      },
      "properties": {
        "capacityLiters": 10000,
        "currentLiters": 0,
        "overflowActive": false
      }
    },
    {
      "id": "fc37-detect",
      "componentId": "sensor.rain.fc-37",
      "position": {
        "x": 1340,
        "y": 500
      },
      "properties": {
        "thresholdPercent": 50,
        "wetAnalogValue": 1600,
        "dryAnalogValue": 120,
        "activeLow": true
      }
    },
    {
      "id": "fc37-income",
      "componentId": "sensor.rain.fc-37",
      "position": {
        "x": 1340,
        "y": 675
      },
      "properties": {
        "thresholdPercent": 50,
        "wetAnalogValue": 1600,
        "dryAnalogValue": 120,
        "activeLow": true
      }
    }
  ],
  "connections": [
    {
      "id": "net-power-asker",
      "color": "#f05252",
      "terminals": [
        "esp8266-asker.3v3",
        "ssr-1.vcc",
        "ssr-1.loadIn"
      ]
    },
    {
      "id": "net-gnd-asker",
      "color": "#f5f7fa",
      "terminals": [
        "esp8266-asker.gnd",
        "ssr-1.gnd",
        "pump-1.gnd"
      ]
    },
    {
      "id": "net-relay-control",
      "color": "#45d6c4",
      "terminals": [
        "esp8266-asker.d5",
        "ssr-1.in"
      ]
    },
    {
      "id": "net-pump-switched",
      "color": "#ffb454",
      "terminals": [
        "ssr-1.loadOut",
        "pump-1.vin"
      ]
    },
    {
      "id": "net-power-sender",
      "color": "#f05252",
      "terminals": [
        "esp32-sender.3v3",
        "fc37-detect.vcc",
        "fc37-income.vcc"
      ]
    },
    {
      "id": "net-gnd-sender",
      "color": "#f5f7fa",
      "terminals": [
        "esp32-sender.gnd",
        "fc37-detect.gnd",
        "fc37-income.gnd"
      ]
    },
    {
      "id": "net-detect-analog",
      "color": "#6fbf73",
      "terminals": [
        "fc37-detect.ao",
        "esp32-sender.io34"
      ]
    },
    {
      "id": "net-income-analog",
      "color": "#7aa7ff",
      "terminals": [
        "fc37-income.ao",
        "esp32-sender.io35"
      ]
    }
  ],
  "environmentConnections": [
    {
      "source": "wifi-1.env",
      "target": "esp8266-asker.d1",
      "color": "#6fbf73"
    },
    {
      "source": "wifi-1.env",
      "target": "esp32-sender.io21",
      "color": "#6fbf73"
    },
    {
      "source": "pump-1.outlet",
      "target": "reservoir-1.water",
      "color": "#72d7ff"
    },
    {
      "source": "reservoir-1.water",
      "target": "fc37-detect.ao",
      "color": "#72d7ff"
    },
    {
      "source": "reservoir-1.water",
      "target": "fc37-income.ao",
      "color": "#72d7ff"
    }
  ],
  "network": {
    "mqtt": {
      "mode": "real",
      "brokers": {
        "192.168.200.70": {
          "port": 1883,
          "online": true,
          "messages": []
        }
      }
    }
  },
  "firmwares": {
    "esp8266-asker": {
      "language": "arduino-cpp",
      "entry": "main-esp8266-asker.ino",
      "files": {
        "main-esp8266-asker.ino": {
          "path": "./firmware/main-esp8266-asker.ino"
        }
      }
    },
    "esp32-sender": {
      "language": "arduino-cpp",
      "entry": "main-esp32-sender.ino",
      "files": {
        "main-esp32-sender.ino": {
          "path": "./firmware/main-esp32-sender.ino"
        }
      }
    }
  },
  "code": {
    "language": "arduino-cpp",
    "entry": "main-esp8266-asker.ino",
    "files": {
      "main-esp8266-asker.ino": {
        "path": "./firmware/main-esp8266-asker.ino"
      }
    }
  }
}
