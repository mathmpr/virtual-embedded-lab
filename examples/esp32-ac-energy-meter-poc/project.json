{
  "schemaVersion": "1.0.0",
  "name": "ESP32 AC Energy Meter POC",
  "board": {
    "width": 1800,
    "height": 980,
    "gridSize": 10
  },
  "components": [
    {
      "id": "esp32-1",
      "componentId": "board.esp32.devkit",
      "position": {
        "x": 180,
        "y": 250
      },
      "properties": {
        "logicVoltage": 3.3,
        "wifiMode": "idle",
        "bluetoothEnabled": true
      }
    },
    {
      "id": "ads-1",
      "componentId": "converter.adc.ads1115",
      "position": {
        "x": 620,
        "y": 300
      },
      "properties": {
        "i2cAddress": 72,
        "gain": "4.096V",
        "sampleRateSps": 860,
        "mode": "single-shot"
      }
    },
    {
      "id": "mains-1",
      "componentId": "environment.ac-mains",
      "position": {
        "x": 1130,
        "y": 90
      },
      "properties": {
        "frequencyHz": 60,
        "phaseNeutralVoltage": 127,
        "phasePhaseVoltage": 220,
        "threePhaseVoltage": 380,
        "phaseAOffsetDeg": 0,
        "phaseBOffsetDeg": -120,
        "phaseCOffsetDeg": 120,
        "voltageNoisePercent": 0,
        "voltageSagPercent": 0
      }
    },
    {
      "id": "load-a",
      "componentId": "environment.ac-load",
      "position": {
        "x": 1410,
        "y": 70
      },
      "properties": {
        "connection": "A_N",
        "loadType": "inductive",
        "activePowerW": 380,
        "powerFactor": 0.94,
        "enabled": true,
        "label": "A-N load"
      }
    },
    {
      "id": "load-b",
      "componentId": "environment.ac-load",
      "position": {
        "x": 1410,
        "y": 230
      },
      "properties": {
        "connection": "B_N",
        "loadType": "electronic",
        "activePowerW": 250,
        "powerFactor": 0.92,
        "enabled": true,
        "label": "B-N load"
      }
    },
    {
      "id": "load-ab",
      "componentId": "environment.ac-load",
      "position": {
        "x": 1410,
        "y": 390
      },
      "properties": {
        "connection": "A_B",
        "loadType": "resistive",
        "activePowerW": 1200,
        "powerFactor": 1,
        "enabled": true,
        "label": "A-B 220V load"
      }
    },
    {
      "id": "zmpt-a",
      "componentId": "sensor.voltage.zmpt101b",
      "position": {
        "x": 910,
        "y": 230
      },
      "properties": {
        "phase": "A",
        "reference": "N",
        "inputVoltageVrms": 127,
        "outputPeakToPeakV": 2,
        "adcBiasV": 1.65,
        "gain": 1,
        "noisePercent": 0,
        "phaseShiftDeg": 0
      }
    },
    {
      "id": "sct-a",
      "componentId": "sensor.current.sct",
      "position": {
        "x": 910,
        "y": 380
      },
      "properties": {
        "phase": "A",
        "ratedCurrentA": 100,
        "outputMode": "voltage",
        "outputVoltageVrmsAtRatedCurrent": 1,
        "burdenOhms": 0,
        "orientation": "normal",
        "noisePercent": 0,
        "phaseShiftDeg": 0,
        "adcBiasV": 1.65
      }
    },
    {
      "id": "zmpt-b",
      "componentId": "sensor.voltage.zmpt101b",
      "position": {
        "x": 910,
        "y": 540
      },
      "properties": {
        "phase": "B",
        "reference": "N",
        "inputVoltageVrms": 127,
        "outputPeakToPeakV": 2,
        "adcBiasV": 1.65,
        "gain": 1,
        "noisePercent": 0,
        "phaseShiftDeg": 0
      }
    },
    {
      "id": "sct-b",
      "componentId": "sensor.current.sct",
      "position": {
        "x": 910,
        "y": 690
      },
      "properties": {
        "phase": "B",
        "ratedCurrentA": 100,
        "outputMode": "voltage",
        "outputVoltageVrmsAtRatedCurrent": 1,
        "burdenOhms": 0,
        "orientation": "normal",
        "noisePercent": 0,
        "phaseShiftDeg": 0,
        "adcBiasV": 1.65
      }
    }
  ],
  "connections": [
    {
      "id": "net-3v3",
      "color": "#f05252",
      "terminals": [
        "esp32-1.3v3",
        "ads-1.vdd",
        "zmpt-a.vcc",
        "sct-a.vcc",
        "zmpt-b.vcc",
        "sct-b.vcc"
      ]
    },
    {
      "id": "net-gnd",
      "color": "#f5f7fa",
      "terminals": [
        "esp32-1.gnd",
        "ads-1.gnd",
        "zmpt-a.gnd",
        "sct-a.gnd",
        "zmpt-b.gnd",
        "sct-b.gnd"
      ]
    },
    {
      "id": "net-i2c-sda",
      "color": "#45d6c4",
      "terminals": [
        "esp32-1.io21",
        "ads-1.sda"
      ]
    },
    {
      "id": "net-i2c-scl",
      "color": "#4c8dff",
      "terminals": [
        "esp32-1.io22",
        "ads-1.scl"
      ]
    },
    {
      "id": "net-v-a",
      "color": "#ff7a45",
      "terminals": [
        "zmpt-a.out",
        "ads-1.a0"
      ]
    },
    {
      "id": "net-i-a",
      "color": "#f2b84b",
      "terminals": [
        "sct-a.out",
        "ads-1.a1"
      ]
    },
    {
      "id": "net-v-b",
      "color": "#6fbf73",
      "terminals": [
        "zmpt-b.out",
        "ads-1.a2"
      ]
    },
    {
      "id": "net-i-b",
      "color": "#9b8cff",
      "terminals": [
        "sct-b.out",
        "ads-1.a3"
      ]
    }
  ],
  "environmentConnections": [
    {
      "source": "mains-1.env",
      "target": "zmpt-a.env",
      "color": "#ff7a45"
    },
    {
      "source": "mains-1.env",
      "target": "sct-a.env",
      "color": "#ff7a45"
    },
    {
      "source": "mains-1.env",
      "target": "load-a.env",
      "color": "#ff7a45"
    },
    {
      "source": "mains-1.env",
      "target": "load-ab.env",
      "color": "#f2b84b"
    },
    {
      "source": "mains-1.env",
      "target": "zmpt-b.env",
      "color": "#6fbf73"
    },
    {
      "source": "mains-1.env",
      "target": "sct-b.env",
      "color": "#6fbf73"
    },
    {
      "source": "mains-1.env",
      "target": "load-b.env",
      "color": "#6fbf73"
    }
  ],
  "code": {
    "language": "arduino-cpp",
    "entry": "main.ino",
    "files": {
      "main.ino": {
        "path": "./firmware/main.ino"
      }
    }
  }
}
