{
  "schemaVersion": "1.0.0",
  "name": "ESP32 Wi-Fi TCP JSONPlaceholder",
  "description": "Executa uma requisição HTTP virtual via Wi-Fi no ESP32 para consumir uma resposta JSON simulada.",
  "descriptionI18n": {
    "pt-BR": "Executa uma requisição HTTP virtual via Wi-Fi no ESP32 para consumir uma resposta JSON simulada.",
    "en": "Runs a virtual HTTP request over ESP32 Wi-Fi to consume a simulated JSON response.",
    "es": "Ejecuta una solicitud HTTP virtual por Wi-Fi en ESP32 para consumir una respuesta JSON simulada."
  },
  "board": {
    "width": 1600,
    "height": 900,
    "gridSize": 10
  },
  "components": [
    {
      "id": "esp32-1",
      "componentId": "board.esp32.devkit",
      "position": {
        "x": 420,
        "y": 160
      },
      "properties": {
        "logicVoltage": 3.3,
        "wifiMode": "station",
        "bluetoothEnabled": true
      }
    },
    {
      "id": "wifi-1",
      "componentId": "environment.wifi-signal",
      "position": {
        "x": 875,
        "y": 265
      },
      "properties": {
        "ssid": "VirtualLab",
        "connected": true,
        "strengthPercent": 86
      }
    }
  ],
  "connections": [],
  "environmentConnections": [],
  "network": {
    "http": {
      "hosts": {
        "jsonplaceholder.typicode.com": {
          "routes": [
            {
              "method": "GET",
              "path": "/todos/1",
              "statusCode": 200,
              "reason": "OK",
              "body": {
                "userId": 1,
                "id": 1,
                "title": "delectus aut autem",
                "completed": false
              }
            }
          ]
        }
      }
    }
  },
  "code": {
    "language": "arduino-cpp",
    "entry": "main.ino",
    "files": {
      "main.ino": {
        "path": "./firmware/main.ino"
      }
    }
  }
}
