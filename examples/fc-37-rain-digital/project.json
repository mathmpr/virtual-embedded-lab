{
  "schemaVersion": "1.0.0",
  "name": "FC-37 Rain Digital",
  "description": "Lê o estado digital de um sensor de chuva FC-37 no Arduino UNO a partir de uma fonte virtual de chuva.",
  "descriptionI18n": {
    "pt-BR": "Lê o estado digital de um sensor de chuva FC-37 no Arduino UNO a partir de uma fonte virtual de chuva.",
    "en": "Reads the digital state of an FC-37 rain sensor on an Arduino UNO from a virtual rain source.",
    "es": "Lee el estado digital de un sensor de lluvia FC-37 en un Arduino UNO desde una fuente virtual de lluvia."
  },
  "board": {
    "width": 1600,
    "height": 900,
    "gridSize": 10
  },
  "components": [
    {
      "id": "arduino-1",
      "componentId": "board.arduino.uno",
      "position": {
        "x": 260,
        "y": 220
      },
      "properties": {}
    },
    {
      "id": "rain-sensor-1",
      "componentId": "sensor.rain.fc-37",
      "position": {
        "x": 720,
        "y": 250
      },
      "properties": {
        "thresholdPercent": 50,
        "wetAnalogValue": 300,
        "dryAnalogValue": 900,
        "activeLow": true
      }
    },
    {
      "id": "rain-1",
      "componentId": "environment.rain-toggle",
      "position": {
        "x": 970,
        "y": 250
      },
      "properties": {
        "active": false,
        "intensityPercent": 100
      }
    }
  ],
  "connections": [
    {
      "id": "net-1",
      "color": "#f05252",
      "terminals": [
        "arduino-1.5v",
        "rain-sensor-1.vcc"
      ]
    },
    {
      "id": "net-2",
      "color": "#f5f7fa",
      "terminals": [
        "arduino-1.gnd",
        "rain-sensor-1.gnd"
      ]
    },
    {
      "id": "net-3",
      "color": "#4c8dff",
      "terminals": [
        "arduino-1.d7",
        "rain-sensor-1.do"
      ]
    }
  ],
  "environmentConnections": [],
  "code": {
    "language": "arduino-cpp",
    "entry": "main.ino",
    "files": {
      "main.ino": {
        "path": "./firmware/main.ino"
      }
    }
  }
}
